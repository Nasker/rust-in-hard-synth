# serviSynth-proven board config — 16MB flash, octal PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_HTTPD_WS_SUPPORT=y

# httpd alone can hold 14 sockets (listen + ctrl + 12 sessions); DNS :53 + a
# spare need headroom over the default of 10.
CONFIG_LWIP_MAX_SOCKETS=16

# A-MPDU TX was NOT the root cause (large frames died with or without it), but
# a control-UI workload gains nothing from aggregation; keep it off to keep
# the TX path simple.
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n

CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
# 16384 starves internal SRAM: every malloc <=16KB (voice structs, httpd/lwIP
# bookkeeping) ate the pool DMA buffers need -> ~13KB free -> a single stalled
# TCP session's ~7KB of TX pbufs nearly exhausted it and every big TX after
# that silently died. Keep small allocs internal; let the rest use PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
# lwIP/Wi-Fi buffers try PSRAM first (driver copies TX into its own internal
# DMA buffers anyway); internal RAM reserved for genuine DMA-capable allocs.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Core 1 is a dedicated realtime audio render loop — it legitimately starves
# IDLE1 under full polyphony. The default WDT idle-check then fires every 5s
# and its backtrace printing stalls render ~20ms (making underruns worse).
# The `late:` telemetry counter reports real overrun instead.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Rust main() + logging needs more headroom than the 3.5K default
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Many MIDI controllers expose an internal USB hub (or connect via one)
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HUB_MULTI_LEVEL=y

# (partitions.csv in crate root is picked up automatically by esp-idf-sys)
